    "# ----- Figure 2: where the positive outcomes come from (revised labels) -----\n",
    "# Uses the analysis cohort (same as the model): ASA 6, missing surgery times and same-stay deaths excluded.\n",
    "fd = target_df[in_cohort(target_df)]\n",
    "r = fd[\"readmit_any\"] == 1\n",
    "c = fd[\"complication_code\"] == 1\n",
    "d = (fd[\"death_30d\"] == 1) if INCLUDE_DEATH else pd.Series(False, index=fd.index)\n",
    "cats = [\"Readmission only\", \"New complication code only\"]\n",
    "vals = [int((r & ~c & ~d).sum()), int((~r & c & ~d).sum())]\n",
    "if INCLUDE_DEATH:\n",
    "    cats.append(\"Death only\\n(no readmission or code)\")\n",
    "    vals.append(int((~r & ~c & d).sum()))\n",
    "cats.append(\"More than one\")\n",
    "vals.append(int(((r.astype(int) + c.astype(int) + d.astype(int)) >= 2).sum()))\n",
    "n_all, n_pos = len(fd), int(fd[\"Post_discharge_complication_any\"].sum())\n",
    "assert sum(vals) == n_pos, (sum(vals), n_pos)\n",
    "n_emerg, n_readmit = int(fd[\"readmit_emergency\"].sum()), int(fd[\"readmit_any\"].sum())\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6.5, 0.65 * len(cats) + 0.6))\n",
    "ypos = list(range(len(cats)))[::-1]\n",
    "ax.barh(ypos, vals, color=\"black\", height=0.55)\n",
    "for yi, v in zip(ypos, vals):\n",
    "    ax.text(v + max(vals) * 0.02, yi, f\"{v:,}  ({v / n_all:.1%})\", va=\"center\", fontsize=9)\n",
    "ax.set_yticks(ypos); ax.set_yticklabels(cats)\n",
