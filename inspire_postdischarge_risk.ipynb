    "# WHERE: NEW cell. Insert it directly BELOW the cell whose first line is\n",
    "#   # ===== Sensitivity analysis: the \"strict\" outcome\n",
    "# (it needs final_probs from the \"Final results\" cell and the strict-outcome models)\n",
    "# ----------------------------------------------------------------------------------------\n",
    "\n",
    "# ===== Review item 3: calibration slope, calibration intercept and calibration plot =====\n",
    "# Calibration intercept (\"calibration-in-the-large\"): fit logit P(y=1) = a + logit(p),\n",
    "#   with the slope fixed at 1. a = 0 is perfect; a < 0 means the model predicts too high.\n",
    "# Calibration slope: fit logit P(y=1) = a + b * logit(p). b = 1 is perfect;\n",
    "#   b < 1 means the predictions are too extreme, b > 1 too modest.\n",
    "# (Van Calster et al., 2019.) 95% CIs resample patients, like every other CI.\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "def _logistic_fit(y, lp, fix_slope):\n",
    "    a, b = 0.0, 1.0\n",
    "    for _ in range(100):                                   # Newton-Raphson\n",
    "        p = 1 / (1 + np.exp(-(a + b * lp)))\n",
    "        w, r = p * (1 - p), y - p\n",
    "        if fix_slope:\n",
    "            step = np.array([r.sum() / w.sum(), 0.0])\n",
    "        else:\n",
    "            hess = np.array([[w.sum(), (w * lp).sum()], [(w * lp).sum(), (w * lp * lp).sum()]])\n",
    "            step = np.linalg.solve(hess, np.array([r.sum(), (r * lp).sum()]))\n",
    "        a, b = a + step[0], b + step[1]\n",
    "        if np.abs(step).max() < 1e-8:\n",
    "            break\n",
    "    return a, b\n",
    "\n",
    "def calibration_intercept_slope(y, p):\n",
    "    y = np.asarray(y, float)\n",
    "    p = np.clip(np.asarray(p, float), 1e-6, 1 - 1e-6)\n",
    "    lp = np.log(p / (1 - p))\n",
    "    return _logistic_fit(y, lp, True)[0], _logistic_fit(y, lp, False)[1]\n",
    "\n",
    "def calibration_with_ci(y_true, y_prob, n_bootstrap=500):\n",
    "    inter, slope = calibration_intercept_slope(y_true, y_prob)\n",
    "    draw = _patient_resampler(_patient_groups(y_true), random_state=42)\n",
    "    yt, yp = np.asarray(y_true), np.asarray(y_prob)\n",
    "    boot = np.array([calibration_intercept_slope(yt[i], yp[i]) for i in (draw() for _ in range(n_bootstrap))])\n",
    "    (i_lo, s_lo), (i_hi, s_hi) = np.percentile(boot, 2.5, axis=0), np.percentile(boot, 97.5, axis=0)\n",
    "    return inter, i_lo, i_hi, slope, s_lo, s_hi\n",
    "\n",
    "# Every model evaluated on the full test set, plus the two strict-outcome models\n",
    "cal_models = [(n, y_test, t) for n, (_, t) in final_probs.items()]\n",
    "cal_models += [(\"Logistic Regression (strict outcome)\", y_test_s, p_lr_test_s),\n",
    "               (\"XGBoost (strict outcome)\", y_test_s, p_xgb_test_s)]\n",
    "rows = []\n",
    "for name, y_true, p in cal_models:\n",
    "    ci = calibration_with_ci(y_true, p)\n",
    "    rows.append({\"Model\": name,\n",
    "                 \"Mean predicted risk\": round(float(np.mean(p)), 3), \"Observed rate\": round(float(np.mean(y_true)), 3),\n",
    "                 \"Calibration intercept (95% CI)\": f\"{ci[0]:+.2f} ({ci[1]:+.2f} to {ci[2]:+.2f})\",\n",
    "                 \"Calibration slope (95% CI)\": f\"{ci[3]:.2f} ({ci[4]:.2f}-{ci[5]:.2f})\",\n",
    "                 \"Brier\": round(brier_score_loss(y_true, p), 4)})\n",
    "calibration_table = pd.DataFrame(rows)\n",
    "print(calibration_table.to_string(index=False))\n",
    "calibration_table.to_csv(\"calibration_table.csv\", index=False)\n",
    "cal_lookup = {r[\"Model\"]: r for r in rows}\n",
    "\n",
    "# ---- Calibration plot (can replace Fig. 5, the mean-predicted-risk bar chart) ----\n",
    "# 10 groups of equal size by predicted risk; each point = mean predicted vs observed rate.\n",
    "panels = [\n",
    "    (\"(a) Trained without class weights\", [\n",
    "        (\"Logistic regression\", \"Logistic Regression\", \"black\", \"-\", \"o\"),\n",
    "        (\"XGBoost\", \"XGBoost (unweighted)\", \"dimgray\", \"--\", \"s\"),\n",
    "        (\"Random forest\", \"Random Forest (tuned, unweighted)\", \"gray\", \":\", \"^\"),\n",
    "        (\"LSTM (vitals only)\", \"LSTM (vitals only)\", \"darkgray\", \"-.\", \"D\")]),\n",
    "    (\"(b) Trained with class weights\", [\n",
    "        (\"Logistic regression\", \"Logistic Regression (weighted)\", \"black\", \"-\", \"o\"),\n",
    "        (\"XGBoost\", \"XGBoost (scale_pos_weight)\", \"dimgray\", \"--\", \"s\"),\n",
    "        (\"Random forest\", \"Random Forest (tuned)\", \"gray\", \":\", \"^\")]),\n",
    "]\n",
    "fig, axes = plt.subplots(1, 2, figsize=(7.2, 3.4))\n",
    "for ax, (title, models_in_panel) in zip(axes, panels):\n",
    "    top = 0\n",
    "    for label, key, color, ls, marker in models_in_panel:\n",
    "        if key not in final_probs:\n",
    "            continue\n",
    "        p = final_probs[key][1]\n",
    "        frac_pos, mean_pred = calibration_curve(y_test, p, n_bins=10, strategy=\"quantile\")\n",
