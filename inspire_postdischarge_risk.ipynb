    "## Week 5: Baseline Models — Logistic Regression, Random Forest (tuned)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9df3c5a0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set up the machinery that prepares our data for the models:\n",
    "# fill missing numbers with the TRAINING median (plus a yes/no \"was missing\"\n",
    "# column), scale the numbers, and convert categories (like sex, department)\n",
    "# into a format the models can understand. Rare procedure codes (<30 cases)\n",
    "# are grouped together so the model can't memorise them.\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    roc_auc_score, average_precision_score, precision_recall_curve, classification_report\n",
    ")\n",
    "\n",
    "categorical_cols = [\"sex\", \"race\", \"department\", \"antype\", \"asa\", \"emop\", \"icd10_pcs\"]\n",
    "numerical_cols = [c for c in feature_cols if c not in categorical_cols]\n",
    "\n",
    "X_train = X_train.copy()\n",
    "X_val = X_val.copy()\n",
    "X_test = X_test.copy()\n",
    "for col in categorical_cols:\n",
    "    X_train[col] = X_train[col].fillna(\"Unknown\").astype(str)\n",
    "    X_val[col] = X_val[col].fillna(\"Unknown\").astype(str)\n",
    "    X_test[col] = X_test[col].fillna(\"Unknown\").astype(str)\n",
    "\n",
    "numeric_pipe = Pipeline([\n",
    "    (\"impute\", SimpleImputer(strategy=\"median\", add_indicator=True)),  # medians from TRAIN only\n",
    "    (\"scale\", StandardScaler()),\n",
    "])\n",
    "categorical_pipe = Pipeline([\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"infrequent_if_exist\", min_frequency=30)),\n",
    "])\n",
    "preprocessor = ColumnTransformer(transformers=[\n",
    "    (\"num\", numeric_pipe, numerical_cols),\n",
    "    (\"cat\", categorical_pipe, categorical_cols),\n",
    "])\n",
    "\n",
    "print(f\"{len(numerical_cols)} numeric + {len(categorical_cols)} categorical columns\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9f19334e",
   "metadata": {},
   "source": [
    "**Note on metrics:** the target is ~6% positive. ROC-AUC can look fine while a model is still\n",
    "practically useless at the default 0.5 threshold, and accuracy is nearly meaningless (predicting\n",
    "\"no complication\" for everyone already scores ~94%). PR-AUC (`average_precision_score`) is a\n",
    "better read on how useful the model actually is at finding the rare positive cases.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "09d420a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train our first, simplest model (Logistic Regression) two ways, to justify\n",
    "# how we handle class imbalance (~6% complications):\n",
    "#   - unweighted: every patient counts equally\n",
    "#   - balanced:   complication cases weighted up ~15x (class_weight=\"balanced\")\n",
    "# Ranking metrics (ROC-AUC, PR-AUC) are usually similar; the difference shows\n",
    "# in CALIBRATION - whether predicted risks match the real complication rate.\n",
    "from sklearn.base import clone\n",
    "from sklearn.metrics import brier_score_loss\n",
    "\n",
    "lr_models = {}\n",
    "for name, weight in [(\"unweighted\", None), (\"balanced\", \"balanced\")]:\n",
    "    model = Pipeline([\n",
    "        (\"preprocessor\", clone(preprocessor)),\n",
    "        (\"classifier\", LogisticRegression(max_iter=2000, class_weight=weight, random_state=42)),\n",
    "    ])\n",
    "    model.fit(X_train, y_train)\n",
    "    lr_models[name] = model\n",
    "\n",
    "rows = []\n",
    "for name, model in lr_models.items():\n",
    "    p = model.predict_proba(X_test)[:, 1]\n",
    "    rows.append({\n",
    "        \"Logistic Regression\": name,\n",
    "        \"ROC-AUC\": round(roc_auc_score(y_test, p), 3),\n",
    "        \"PR-AUC\": round(average_precision_score(y_test, p), 3),\n",
    "        \"Brier (lower=better)\": round(brier_score_loss(y_test, p), 4),\n",
    "        \"Mean predicted risk\": round(p.mean(), 3),\n",
    "        \"True rate\": round(y_test.mean(), 3),\n",
    "    })\n",
    "lr_comparison = pd.DataFrame(rows)\n",
    "print(lr_comparison.to_string(index=False))\n",
    "\n",
    "# Main model used in the rest of the notebook: unweighted (better-calibrated risks)\n",
    "logistic_model = lr_models[\"unweighted\"]\n",
    "y_prob_lr = logistic_model.predict_proba(X_test)[:, 1]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3f621b80",
   "metadata": {},
   "source": [
    "**Random Forest note:** `class_weight=\"balanced\"` only reweights _tree building_, not the\n",
    "`.predict()` decision rule, which still defaults to a 0.5 cutoff. With ~94:6 imbalance the averaged\n",
    "vote can stay under 0.5 for nearly every sample even when the model has learned real structure - so\n",
    "we tune the decision threshold from the precision-recall curve instead of trusting the default.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ec548f56",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train a more complex model (Random Forest), check its performance on the\n",
    "# test set, and choose the cutoff for turning its risk score into a yes/no\n",
    "# call on the VALIDATION set (never on test), then apply that cutoff to test.\n",
    "from sklearn.base import clone\n",
    "from sklearn.metrics import brier_score_loss\n",
    "\n",
    "rf_model = Pipeline([\n",
    "    (\"preprocessor\", clone(preprocessor)),\n",
    "    (\"classifier\", RandomForestClassifier(\n",
    "        n_estimators=200, random_state=42, class_weight=\"balanced\", n_jobs=-1\n",
    "    ))\n",
    "])\n",
    "rf_model.fit(X_train, y_train)\n",
    "\n",
    "y_prob_rf = rf_model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "print(\"Random Forest - ROC-AUC:\", round(roc_auc_score(y_test, y_prob_rf), 3))\n",
    "print(\"Random Forest - PR-AUC:\", round(average_precision_score(y_test, y_prob_rf), 3))\n",
    "print(\"Random Forest - Brier:\", round(brier_score_loss(y_test, y_prob_rf), 4),\n",
    "      \"| mean predicted risk:\", round(y_prob_rf.mean(), 3), \"| true rate:\", round(y_test.mean(), 3))\n",
    "\n",
    "# Choose the decision threshold on the VALIDATION set (max F1), then apply it to test\n",
    "y_prob_rf_val_untuned = rf_model.predict_proba(X_val)[:, 1]\n",
    "precisions, recalls, thresholds = precision_recall_curve(y_val, y_prob_rf_val_untuned)\n",
    "f1_scores = 2 * (precisions[:-1] * recalls[:-1]) / (precisions[:-1] + recalls[:-1] + 1e-12)\n",
    "best_threshold = thresholds[f1_scores.argmax()]\n",
    "\n",
    "y_pred_rf_tuned = (y_prob_rf >= best_threshold).astype(int)\n",
    "print(f\"\\nThreshold chosen on validation: {best_threshold:.3f}\")\n",
    "print(classification_report(y_test, y_pred_rf_tuned))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d0f59105",
   "metadata": {},
   "source": [
    "### Hyperparameter tuning (RandomizedSearchCV + StratifiedKFold)\n",
    "\n",
    "Scored on PR-AUC (`average_precision`) rather than accuracy, given the imbalance. `n_jobs=-1` uses\n",
    "all cores but multiplies memory use - drop to 2 (or lower `n_iter`) if this crashes.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "41ca8b3b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Settings to try when tuning the Random Forest, and how to cross-validate.\n",
    "# Scored on PR-AUC (average_precision) rather than accuracy, given the imbalance.\n",
    "from sklearn.model_selection import RandomizedSearchCV, StratifiedGroupKFold\n",
    "\n",
    "rf_param_grid = {\n",
    "    \"classifier__n_estimators\": [100, 200, 300, 500],\n",
    "    \"classifier__max_depth\": [None, 5, 10, 20, 30],\n",
    "    \"classifier__min_samples_split\": [2, 5, 10],\n",
    "    \"classifier__min_samples_leaf\": [1, 2, 4, 8],\n",
    "    \"classifier__max_features\": [\"sqrt\", \"log2\", None],\n",
    "}\n",
    "\n",
    "# Cross-validation folds split BY PATIENT, same as the train/val/test split\n",
    "cv = StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=42)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b3dbddda",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "\n",
    "# Load the tuned Random Forest ONLY if the saved file was trained on the current\n",
    "# training set; otherwise tune it again (slow) and save it.\n",
    "# REVISED (Nov 23): before, any old rf_tuned.joblib was loaded without a check,\n",
    "# which gave the fake ROC-AUC of 0.899. Now a small \"fingerprint\" (which surgeries\n",
    "# and which labels the forest was trained on) is saved next to it, and the file is\n",
    "# only reused when the fingerprint matches.\n",
    "import joblib, hashlib\n",
    "from pathlib import Path\n",
    "from sklearn.base import clone\n",
    "\n",
    "RF_FILE = Path(\"rf_tuned.joblib\")\n",
    "RF_FP_FILE = Path(\"rf_tuned_fingerprint.txt\")\n",
    "\n",
    "def training_fingerprint():\n",
    "    # Which training surgeries, with which labels, and which features\n",
    "    fp = pd.DataFrame({\"op\": model_df.loc[X_train.index, \"op_id\"].to_numpy(),\n",
    "                       \"y\": y_train.to_numpy()}).sort_values(\"op\")\n",
    "    h = hashlib.md5(fp.to_numpy().astype(\"int64\").tobytes())\n",
    "    h.update(\",\".join(feature_cols).encode())\n",
    "    return h.hexdigest()\n",
    "\n",
    "def medians_match(model):\n",
    "    # A forest saved before fingerprints existed: its imputer stored the training\n",
    "    # medians, which only match if it was trained on this same training split.\n",
    "    try:\n",
    "        imp = model.named_steps[\"preprocessor\"].named_transformers_[\"num\"].named_steps[\"impute\"]\n",
    "        return np.allclose(imp.statistics_, X_train[numerical_cols].median().to_numpy(), equal_nan=True)\n",
    "    except Exception:\n",
    "        return False\n",
