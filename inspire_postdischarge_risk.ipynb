    "# For each model: ROC-AUC and PR-AUC with 95% CIs, Brier score, calibration,\n",
    "# and sensitivity/specificity/precision at a threshold chosen on VALIDATION.\n",
    "def pick_threshold_on_val(y_val_true, y_val_prob):\n",
    "    p, r, t = precision_recall_curve(y_val_true, y_val_prob)\n",
    "    f1 = 2 * p[:-1] * r[:-1] / (p[:-1] + r[:-1] + 1e-12)\n",
    "    return t[f1.argmax()]\n",
    "\n",
    "def evaluate(name, y_val_prob, y_test_prob, y_val_true=None, y_test_true=None):\n",
    "    y_val_true = y_val if y_val_true is None else y_val_true\n",
    "    y_test_true = y_test if y_test_true is None else y_test_true\n",
    "    thr = pick_threshold_on_val(y_val_true, y_val_prob)\n",
    "    y_pred = (y_test_prob >= thr).astype(int)\n",
    "    tn, fp, fn, tp = confusion_matrix(y_test_true, y_pred).ravel()\n",
    "    roc, roc_lo, roc_hi = bootstrap_ci(y_test_true, y_test_prob, roc_auc_score)\n",
    "    pr, pr_lo, pr_hi = bootstrap_ci(y_test_true, y_test_prob, average_precision_score)\n",
    "    sens = tp / (tp + fn); spec = tn / (tn + fp); prec = tp / (tp + fp) if (tp + fp) else 0.0\n",
    "    return {\n",
    "        \"Model\": name,\n",
    "        \"ROC-AUC\": f\"{roc:.3f} ({roc_lo:.3f}-{roc_hi:.3f})\",\n",
    "        \"PR-AUC\": f\"{pr:.3f} ({pr_lo:.3f}-{pr_hi:.3f})\",\n",
    "        \"Brier\": round(brier_score_loss(y_test_true, y_test_prob), 4),\n",
    "        \"Mean predicted risk\": round(float(np.mean(y_test_prob)), 3),\n",
    "        \"True rate\": round(float(np.mean(y_test_true)), 3),\n",
    "        \"Threshold (from val)\": round(float(thr), 3),\n",
    "        \"Sensitivity\": round(sens, 3), \"Specificity\": round(spec, 3),\n",
    "        \"Precision (PPV)\": round(prec, 3), \"F1\": round(2 * prec * sens / (prec + sens + 1e-12), 3),\n",
    "    }"
   ]
