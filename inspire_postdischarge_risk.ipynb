    "# ===== Load only those 11 labs from the (very large) labevents file, in chunks =====\n",
    "# Reading in chunks keeps memory low. hadm_id is NOT loaded: it isn't needed (labs are\n",
    "# matched by patient + time below), and storing it as float32 silently rounds the IDs.\n",
    "lab_chunks = []\n",
    "for chunk in pd.read_csv(mimic_core_folder / \"hosp\" / \"labevents.csv.gz\",\n",
    "                         usecols=[\"subject_id\", \"itemid\", \"charttime\", \"valuenum\"],\n",
    "                         dtype={\"subject_id\": \"int32\", \"itemid\": \"int32\", \"valuenum\": \"float32\"},\n",
    "                         chunksize=5_000_000):\n",
    "    lab_chunks.append(chunk[chunk[\"itemid\"].isin(candidate_itemids.keys())\n",
    "                            & chunk[\"valuenum\"].notna()])\n",
    "labevents_filtered = pd.concat(lab_chunks, ignore_index=True)\n",
    "del lab_chunks\n",
    "\n",
    "labevents_filtered[\"charttime\"] = pd.to_datetime(labevents_filtered[\"charttime\"])\n",
    "print(labevents_filtered.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2d32579a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ===== Preoperative labs: most recent value in the 30 days BEFORE surgery =====\n",
    "# Same rule as INSPIRE (30-day lookback before the operation). Before, MIMIC labs had to be\n",
    "# taken before ADMISSION and inside the same hadm_id, which kept only ~13k admissions.\n",
    "# MIMIC only gives the procedure DATE, so \"before surgery\" = before midnight of that day\n",
    "# (this avoids accidentally using post-operative labs from the day of surgery).\n",
    "surgery_times = mimic_cohort[[\"hadm_id\", \"subject_id\", \"surgery_date\"]].copy()\n",
    "# merge_asof needs the matching columns to have exactly the same types on both sides\n",
    "surgery_times[\"subject_id\"] = surgery_times[\"subject_id\"].astype(\"int64\")\n",
    "surgery_times[\"surgery_date\"] = surgery_times[\"surgery_date\"].astype(\"datetime64[ns]\")\n",
    "surgery_times = surgery_times.sort_values(\"surgery_date\")\n",
    "\n",
    "mimic_labs_wide = mimic_cohort[[\"hadm_id\"]].copy()\n",
    "for itemid, lab_name in candidate_itemids.items():\n",
    "    one_lab = (labevents_filtered.loc[labevents_filtered[\"itemid\"] == itemid,\n",
    "                                      [\"subject_id\", \"charttime\", \"valuenum\"]]\n",
    "               .dropna(subset=[\"charttime\"])\n",
    "               .astype({\"subject_id\": \"int64\", \"charttime\": \"datetime64[ns]\"})\n",
    "               .sort_values(\"charttime\"))\n",
    "    matched = pd.merge_asof(\n",
    "        surgery_times, one_lab,\n",
    "        left_on=\"surgery_date\", right_on=\"charttime\", by=\"subject_id\",\n",
    "        direction=\"backward\",                 # most recent value before surgery\n",
    "        allow_exact_matches=False,            # strictly before midnight of surgery day\n",
    "        tolerance=pd.Timedelta(days=30),      # no older than 30 days\n",
    "    )\n",
    "    mimic_labs_wide = mimic_labs_wide.merge(\n",
    "        matched[[\"hadm_id\", \"valuenum\"]].rename(columns={\"valuenum\": lab_name}),\n",
    "        on=\"hadm_id\", how=\"left\")\n",
    "\n",
    "lab_cols = list(candidate_itemids.values())\n",
    "print(\"Share of surgical admissions with each lab available:\")\n",
    "print(mimic_labs_wide[lab_cols].notna().mean().round(3).sort_values(ascending=False))"
   ]
