   "source": [
    "### Target: post-discharge complication\n",
    "\n",
    "Fixed version - uses ICD-10 complication-specific codes (T80-88 plus sepsis/PE/DVT/MI/pneumonia/AKI),\n",
    "not \"any diagnosis\" (which gave an implausible 86% positive rate in an earlier attempt). Combined\n",
    "with a 30-day readmission proxy. Validated at ~5.7% positive rate.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "06d42ea0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ===== TARGET: post-discharge complication (revised after supervisor review, Nov 2026) =====\n",
    "# Built per ADMISSION (one hospital stay can contain several operations), then copied\n",
    "# to every operation in that stay. Positive if, within 30 days after discharge:\n",
    "#   1) the patient is readmitted (any reason; \"strict\" = emergency readmissions only), OR\n",
    "#   2) a complication diagnosis code appears that was NOT already recorded for this\n",
    "#      patient at or before discharge (fix 1: old codes carried forward are not new events), OR\n",
    "#   3) the patient dies (only if INCLUDE_DEATH = True; fix 3)\n",
    "# Excluded: operations whose patient died during the same stay (fix 2). Like ASA 6, they\n",
    "# are never discharged, so they have no post-discharge outcome. MIMIC-IV does the same.\n",
    "TARGET_VERSION = \"any\"        # \"any\" = main outcome; \"strict\" = sensitivity analysis\n",
    "INCLUDE_DEATH = True          # True = death within 30 days of discharge counts as an outcome\n",
    "NEW_CODE_SCOPE = \"stay\"       # \"stay\": code must not appear during this same admission (matches supervisor)\n",
    "                              # \"ever\": code must not appear for this patient at any time up to discharge\n",
    "DISCHARGE_WINDOW_DAYS = 30\n",
    "DAY_MIN = 24 * 60             # INSPIRE times are in minutes\n",
    "COMPLICATION_ICD10_PREFIXES = (\"T8\", \"A40\", \"A41\", \"I26\", \"I80\", \"I81\", \"I82\", \"I21\", \"J18\", \"N17\")\n",
    "\n",
    "diagnosis = datasets[\"diagnosis\"] if \"diagnosis\" in datasets else diagnosis\n",
    "assert \"hadm_id\" in operations.columns, \"operations has no hadm_id column - tell Claude\"\n",
    "\n",
    "# --- One row per admission -------------------------------------------------\n",
    "admissions = (\n",
    "    operations[[\"subject_id\", \"hadm_id\", \"admission_time\", \"discharge_time\"]]\n",
    "    .dropna(subset=[\"admission_time\", \"discharge_time\"])\n",
    "    .drop_duplicates(\"hadm_id\")\n",
    "    .sort_values([\"subject_id\", \"admission_time\"])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "adm_emergency = operations.groupby(\"hadm_id\")[\"emop\"].max()\n",
    "# Death times per admission (earliest recorded, in case rows of the same stay differ)\n",
    "adm_death = operations.groupby(\"hadm_id\")[[\"inhosp_death_time\", \"allcause_death_time\"]].min()\n",
    "admissions = admissions.merge(adm_death, left_on=\"hadm_id\", right_index=True, how=\"left\")\n",
    "\n",
    "# --- 1) Readmission within 30 days (looked up among ALL admissions) ---------\n",
    "admissions[\"next_hadm_id\"] = admissions.groupby(\"subject_id\")[\"hadm_id\"].shift(-1)\n",
    "admissions[\"next_admission_time\"] = admissions.groupby(\"subject_id\")[\"admission_time\"].shift(-1)\n",
    "gap = admissions[\"next_admission_time\"] - admissions[\"discharge_time\"]\n",
    "admissions[\"readmit_any\"] = ((gap > 0) & (gap <= DISCHARGE_WINDOW_DAYS * DAY_MIN)).astype(int)\n",
    "admissions[\"readmit_emergency\"] = (\n",
    "    (admissions[\"readmit_any\"] == 1) & (admissions[\"next_hadm_id\"].map(adm_emergency) == 1)\n",
    ").astype(int)\n",
    "\n",
    "# --- 2) Complication codes within 30 days after discharge -------------------\n",
    "comp_diag = diagnosis.loc[\n",
    "    diagnosis[\"icd10_cm\"].astype(str).str.startswith(COMPLICATION_ICD10_PREFIXES),\n",
    "    [\"subject_id\", \"chart_time\", \"icd10_cm\"],\n",
    "].dropna(subset=[\"chart_time\"]).copy()\n",
    "comp_diag[\"icd10_cm\"] = comp_diag[\"icd10_cm\"].astype(str)\n",
    "\n",
    "# Attach each complication code to the most recent discharge before it\n",
    "comp_after = pd.merge_asof(\n",
    "    comp_diag.sort_values(\"chart_time\"),\n",
    "    admissions[[\"subject_id\", \"hadm_id\", \"admission_time\", \"discharge_time\"]].sort_values(\"discharge_time\"),\n",
    "    left_on=\"chart_time\", right_on=\"discharge_time\", by=\"subject_id\", direction=\"backward\",\n",
    ")\n",
    "days_after = (comp_after[\"chart_time\"] - comp_after[\"discharge_time\"]) / DAY_MIN\n",
    "comp_after = comp_after[comp_after[\"hadm_id\"].notna() & (days_after > 0)\n",
    "                        & (days_after <= DISCHARGE_WINDOW_DAYS)].copy()\n",
    "\n",
    "# Was the same code already recorded for this patient...\n",
    "#   \"ever\": at any time up to (and including) this discharge\n",
    "first_seen = comp_diag.groupby([\"subject_id\", \"icd10_cm\"])[\"chart_time\"].min().rename(\"first_seen\")\n",
    "comp_after = comp_after.merge(first_seen, left_on=[\"subject_id\", \"icd10_cm\"], right_index=True, how=\"left\")\n",
    "comp_after[\"old_ever\"] = comp_after[\"first_seen\"] <= comp_after[\"discharge_time\"]\n",
    "#   \"stay\": during this same admission (admission_time .. discharge_time)\n",
    "pairs = comp_after[[\"subject_id\", \"hadm_id\", \"icd10_cm\", \"admission_time\", \"discharge_time\"]].drop_duplicates()\n",
    "in_stay = pairs.merge(comp_diag, on=[\"subject_id\", \"icd10_cm\"], how=\"inner\")\n",
    "in_stay = in_stay[(in_stay[\"chart_time\"] >= in_stay[\"admission_time\"])\n",
    "                  & (in_stay[\"chart_time\"] <= in_stay[\"discharge_time\"])]\n",
    "in_stay = in_stay[[\"subject_id\", \"hadm_id\", \"icd10_cm\"]].drop_duplicates().assign(old_stay=True)\n",
    "comp_after = comp_after.merge(in_stay, on=[\"subject_id\", \"hadm_id\", \"icd10_cm\"], how=\"left\")\n",
    "comp_after[\"old_stay\"] = comp_after[\"old_stay\"].eq(True)\n",
    "\n",
    "admissions[\"complication_code_old_rule\"] = admissions[\"hadm_id\"].isin(comp_after[\"hadm_id\"]).astype(int)\n",
    "for scope in [\"ever\", \"stay\"]:\n",
    "    new_hadm = comp_after.loc[~comp_after[f\"old_{scope}\"], \"hadm_id\"].unique()\n",
    "    admissions[f\"complication_code_new_{scope}\"] = admissions[\"hadm_id\"].isin(new_hadm).astype(int)\n",
    "admissions[\"complication_code\"] = admissions[f\"complication_code_new_{NEW_CODE_SCOPE}\"]\n",
    "\n",
    "# --- Deaths ---------------------------------------------------------------\n",
    "adm_t, dis_t = admissions[\"admission_time\"], admissions[\"discharge_time\"]\n",
    "inhosp, allcause = admissions[\"inhosp_death_time\"], admissions[\"allcause_death_time\"]\n",
    "# An in-hospital death recorded up to 1 day after this stay's discharge time is a death\n",
    "# in THIS stay (the time stamps differ slightly), not a post-discharge death.\n",
    "admissions[\"died_in_stay_inhosp\"] = inhosp.between(adm_t, dis_t + DAY_MIN).astype(int)\n",
    "admissions[\"died_in_stay\"] = (inhosp.between(adm_t, dis_t + DAY_MIN) | allcause.between(adm_t, dis_t)).astype(int)\n",
    "death_days = (np.fmin(inhosp.where(inhosp > dis_t), allcause.where(allcause > dis_t)) - dis_t) / DAY_MIN\n",
    "admissions[\"death_30d\"] = ((death_days > 0) & (death_days <= DISCHARGE_WINDOW_DAYS)\n",
    "                           & (admissions[\"died_in_stay\"] == 0)).astype(int)\n",
    "\n",
    "# --- Copy to every operation ----------------------------------------------\n",
    "target_df = operations[[\"subject_id\", \"op_id\", \"hadm_id\", \"asa\", \"opstart_time\", \"opend_time\"]].merge(\n",
    "    admissions[[\"hadm_id\", \"readmit_any\", \"readmit_emergency\", \"complication_code\",\n",
    "                \"complication_code_old_rule\", \"complication_code_new_ever\", \"complication_code_new_stay\",\n",
    "                \"died_in_stay_inhosp\", \"died_in_stay\", \"death_30d\"]],\n",
    "    on=\"hadm_id\", how=\"inner\",\n",
    ")\n",
    "\n",
    "def label(df, comp_col, strict=False, death=False):\n",
    "    readmit = df[\"readmit_emergency\"] if strict else df[\"readmit_any\"]\n",
    "    y = (readmit == 1) | (df[comp_col] == 1)\n",
    "    if death:\n",
    "        y = y | (df[\"death_30d\"] == 1)\n",
    "    return y.astype(int)\n",
    "\n",
    "# The analysis cohort = ASA 6 excluded and surgery start/end time recorded\n",
    "# (the paper's 130,888 surgeries; cell 38 drops the 14 without times later)\n",
    "def in_cohort(df):\n",
    "    return (df[\"asa\"] != 6) & df[\"opstart_time\"].notna() & df[\"opend_time\"].notna()\n",
    "\n",
    "# ===== Checks against the supervisor's numbers =====\n",
    "chk = target_df[in_cohort(target_df)]\n",
    "old_any = label(chk, \"complication_code_old_rule\")\n",
    "old_strict = label(chk, \"complication_code_old_rule\", strict=True)\n",
    "print(f\"Operations in analysis cohort: {len(chk):,}   (paper: 130,888)\")\n",
    "print(f\"OLD label positives - any: {old_any.sum():,}   strict: {old_strict.sum():,}\"\n",
    "      f\"   (supervisor: 7,999 / 4,013)\")\n",
    "print(\"\\nFix 1 - count only complication codes first appearing after discharge:\")\n",
    "for scope in [\"ever\", \"stay\"]:\n",
    "    new_any = label(chk, f\"complication_code_new_{scope}\")\n",
    "    new_strict = label(chk, f\"complication_code_new_{scope}\", strict=True)\n",
    "    rm_any, rm_strict = int(old_any.sum() - new_any.sum()), int(old_strict.sum() - new_strict.sum())\n",
    "    print(f\"  scope='{scope}': removes {rm_any:,} of {old_any.sum():,} any ({rm_any/old_any.sum():.0%})\"\n",
    "          f\" and {rm_strict:,} of {old_strict.sum():,} strict ({rm_strict/old_strict.sum():.0%})\"\n",
    "          f\"   (supervisor: 1,217 / 1,251)\")\n",
    "print(\"\\nFix 2 - patient died during the same stay (now excluded):\")\n",
    "print(f\"  by inhosp_death_time only:       {chk['died_in_stay_inhosp'].sum():,} operations\")\n",
    "print(f\"  by inhosp OR allcause death time: {chk['died_in_stay'].sum():,} operations   (supervisor: 814)\")\n",
    "print(f\"  of these, labelled negative by the old rule: {int((old_any[chk['died_in_stay'] == 1] == 0).sum()):,}\")\n",
    "\n",
    "alive = chk[chk[\"died_in_stay\"] == 0]\n",
    "y_no_death = label(alive, \"complication_code\")\n",
    "print(\"\\nFix 3 - death within 30 days of discharge (among operations alive at discharge):\")\n",
    "print(f\"  operations with a death in days 1-30: {alive['death_30d'].sum():,}\")\n",
    "print(f\"  of these, NOT already positive (new positives if INCLUDE_DEATH): \"\n",
    "      f\"{int(((alive['death_30d'] == 1) & (y_no_death == 0)).sum()):,}   (supervisor: 255)\")\n",
    "print(f\"  deaths in days 1-30 outside the hospital (no in-hospital death time): \"\n",
    "      f\"{int(((alive['death_30d'] == 1) & alive['hadm_id'].map(admissions.set_index('hadm_id')['inhosp_death_time']).isna()).sum()):,}\")\n",
    "\n",
    "# ===== Final labels =====\n",
    "target_df = target_df[target_df[\"died_in_stay\"] == 0].copy()   # fix 2\n",
    "target_df[\"Post_discharge_complication_any\"] = label(target_df, \"complication_code\", death=INCLUDE_DEATH)\n",
    "target_df[\"Post_discharge_complication_strict\"] = label(target_df, \"complication_code\", strict=True,\n",
    "                                                        death=INCLUDE_DEATH)\n",
    "target_df[\"Post_discharge_complication\"] = target_df[f\"Post_discharge_complication_{TARGET_VERSION}\"]\n",
    "\n",
    "fin = target_df[in_cohort(target_df)]\n",
    "print(f\"\\nNEW labels (analysis cohort, same-stay deaths excluded, NEW_CODE_SCOPE='{NEW_CODE_SCOPE}', \"\n",
    "      f\"INCLUDE_DEATH={INCLUDE_DEATH}):\")\n",
    "print(f\"  operations: {len(fin):,}\")\n",
    "print(f\"  'any'    positives: {fin['Post_discharge_complication_any'].sum():,}\"\n",
    "      f\"  rate {fin['Post_discharge_complication_any'].mean():.4f}\")\n",
    "print(f\"  'strict' positives: {fin['Post_discharge_complication_strict'].sum():,}\"\n",
    "      f\"  rate {fin['Post_discharge_complication_strict'].mean():.4f}\")\n",
    "print(f\"Used for modelling: '{TARGET_VERSION}'\")\n"
   ]
  },
