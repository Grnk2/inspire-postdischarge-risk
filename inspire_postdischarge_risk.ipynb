   "source": [
    "# ===== Readmission label, computed on ALL admissions =====\n",
    "# Important: the \"next admission\" must be looked up among ALL of a patient's hospital\n",
    "# stays, not only surgical ones - otherwise a readmission for a non-surgical reason\n",
    "# (the most common kind after surgery) would be missed and counted as \"no readmission\".\n",
    "all_adm = admissions.sort_values([\"subject_id\", \"admittime\"]).copy()\n",
    "all_adm[\"next_admittime\"] = all_adm.groupby(\"subject_id\")[\"admittime\"].shift(-1)\n",
    "gap_days = (all_adm[\"next_admittime\"] - all_adm[\"dischtime\"]).dt.total_seconds() / 86400\n",
    "all_adm[\"mimic_readmit\"] = ((gap_days > 0) & (gap_days <= 30)).astype(int)\n",
    "\n",
    "# Patients who died in hospital cannot be readmitted, so they are excluded\n",
    "# (otherwise they would be counted as \"no complication\") - same rule as INSPIRE\n",
    "all_adm = all_adm[all_adm[\"hospital_expire_flag\"] == 0].copy()\n",
    "\n",
    "# Death within 30 days of discharge (same rule as INSPIRE's INCLUDE_DEATH).\n",
    "# MIMIC-IV 'dod' is a date (no time) and includes deaths outside the hospital\n",
    "# from state records, so we compare it with the discharge DATE.\n",
    "dod = pd.to_datetime(patients.set_index(\"subject_id\")[\"dod\"])\n",
    "death_days = (all_adm[\"subject_id\"].map(dod) - all_adm[\"dischtime\"].dt.normalize()).dt.days\n",
