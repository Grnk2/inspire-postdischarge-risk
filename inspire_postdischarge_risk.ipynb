    "      \"| of these not readmitted:\", int(((all_adm[\"mimic_death_30d\"] == 1) & (all_adm[\"mimic_readmit\"] == 0)).sum()))\n",
    "print(f\"30-day outcome rate, all admissions (INCLUDE_DEATH={INCLUDE_DEATH}):\", round(all_adm[\"mimic_target\"].mean(), 4))\n"
