    "\n",
    "\n",
    "# Helper functions for 95% confidence intervals and paired model comparisons.\n",
    "# REVISED (review item 2): the bootstrap now resamples PATIENTS, not surgeries.\n",
    "# A patient is drawn (or left out) together with ALL of their surgeries, which\n",
    "# matches the patient-level train/val/test split. Intervals become slightly wider.\n",
    "#\n",
    "# The patient of each row is found automatically when y_true is a pandas Series\n",
    "# taken from model_df (y_test, y_val, y_llm, y_test_s ...). For other data, such as\n",
    "# MIMIC-IV, pass groups=<patient ID of each row>.\n",
    "PATIENT_OF_ROW = model_df[\"subject_id\"]\n",
    "\n",
    "def _patient_groups(y_true, groups=None):\n",
    "    if groups is not None:\n",
    "        return np.asarray(groups)\n",
    "    if isinstance(y_true, pd.Series):\n",
    "        g = PATIENT_OF_ROW.reindex(y_true.index)\n",
    "        if g.notna().all():\n",
    "            return g.to_numpy()\n",
    "    print(\"WARNING: patient IDs not found for this bootstrap -> resampling rows instead. \"\n",
    "          \"Pass groups=<patient IDs> to fix this.\")\n",
    "    return np.arange(len(y_true))           # every row its own \"patient\" = old behaviour\n",
    "\n",
    "def _patient_resampler(groups, random_state=42):\n",
    "    # Returns a function that draws one bootstrap sample of row positions:\n",
    "    # patients are drawn with replacement, and all rows of each drawn patient are kept.\n",
    "    rng = np.random.RandomState(random_state)\n",
    "    codes, _ = pd.factorize(np.asarray(groups))\n",
    "    order = np.argsort(codes, kind=\"stable\")         # rows grouped by patient\n",
    "    sizes = np.bincount(codes)                        # surgeries per patient\n",
    "    starts = np.concatenate([[0], np.cumsum(sizes)[:-1]])\n",
    "    n_pat = len(sizes)\n",
    "    def draw():\n",
    "        pick = rng.randint(0, n_pat, n_pat)\n",
    "        lens = sizes[pick]\n",
    "        within = np.arange(lens.sum()) - np.repeat(np.cumsum(lens) - lens, lens)\n",
    "        return order[np.repeat(starts[pick], lens) + within]\n",
    "    return draw\n",
    "\n",
    "def bootstrap_ci(y_true, y_prob, metric_func, n_bootstrap=2000, random_state=42, groups=None):\n",
    "    draw = _patient_resampler(_patient_groups(y_true, groups), random_state)\n",
    "    y_true, y_prob = np.asarray(y_true), np.asarray(y_prob)\n",
    "    scores = []\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx = draw()\n",
    "        if len(np.unique(y_true[idx])) < 2:\n",
    "            continue\n",
    "        scores.append(metric_func(y_true[idx], y_prob[idx]))\n",
    "    lo, hi = np.percentile(scores, [2.5, 97.5])\n",
    "    return metric_func(y_true, y_prob), lo, hi\n",
    "\n",
    "def paired_bootstrap_test(y_true, y_prob_a, y_prob_b, metric_func, n_bootstrap=2000, random_state=42, groups=None):\n",
    "    # Same patients resampled for both models; returns mean(A - B), its 95% CI,\n",
    "    # and the fraction of resamples where B was >= A\n",
    "    draw = _patient_resampler(_patient_groups(y_true, groups), random_state)\n",
    "    y_true, y_prob_a, y_prob_b = map(np.asarray, (y_true, y_prob_a, y_prob_b))\n",
    "    diffs = []\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx = draw()\n",
    "        if len(np.unique(y_true[idx])) < 2:\n",
    "            continue\n",
    "        diffs.append(metric_func(y_true[idx], y_prob_a[idx]) - metric_func(y_true[idx], y_prob_b[idx]))\n",
    "    diffs = np.array(diffs)\n",
    "    lo, hi = np.percentile(diffs, [2.5, 97.5])\n",
    "    return diffs.mean(), lo, hi, np.mean(diffs <= 0)\n",
    "\n",
    "print(f\"Bootstrap resamples patients: test set = {len(y_test):,} surgeries from \"\n",
    "      f\"{PATIENT_OF_ROW.loc[y_test.index].nunique():,} patients\")\n"
   ]
  },
