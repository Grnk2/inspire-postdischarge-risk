    "import pickle\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from scipy.signal import find_peaks\n",
    "\n",
    "# Define the WESAD folder HERE, before it is used (it used to be defined later in cell 105,\n",
    "# which only worked because cells were run out of order)\n",
    "wesad_data_folder = Path(\"WESAD\")  # adjust to your actual folder name\n",
    "\n",
    "def extract_wesad_hr_temp(subject_id, wesad_folder):\n",
    "    \"\"\"\n",
    "    Peak-detection HR + wrist TEMP extraction validated on S2 in Week 3,\n",
    "    generalized to run on any subject so we can check the pattern across all of them.\n",
    "    \"\"\"\n",
    "    path = wesad_folder / subject_id / f\"{subject_id}.pkl\"\n",
    "    with open(path, \"rb\") as f:\n",
    "        data = pickle.load(f, encoding=\"latin1\")\n",
    "\n",
    "    # Wrist signals only - chest RespiBAN isn't wearable-comparable\n",
    "    bvp = data[\"signal\"][\"wrist\"][\"BVP\"].flatten()   # pulse waveform, 64Hz\n",
    "    temp = data[\"signal\"][\"wrist\"][\"TEMP\"].flatten()  # skin temperature, 4Hz\n",
    "\n",
    "    bvp_fs = 64\n",
    "    window_sec = 10  # one HR value per 10-second window\n",
    "    window_samples = window_sec * bvp_fs\n",
    "\n",
    "    # Count pulse peaks per window to estimate heart rate (like a wearable's onboard algorithm)\n",
    "    hr_estimates = []\n",
    "    for start in range(0, len(bvp) - window_samples, window_samples):\n",
    "        segment = bvp[start:start + window_samples]\n",
    "        peaks, _ = find_peaks(segment, distance=bvp_fs * 0.4)  # min 0.4s between beats -> caps at 150bpm\n",
    "        hr_estimates.append(len(peaks) * (60 / window_sec))\n",
    "\n",
    "    hr_estimates = np.array(hr_estimates)\n",
    "    return {\n",
    "        \"subject\": subject_id,\n",
    "        \"hr_mean\": hr_estimates.mean(), \"hr_std\": hr_estimates.std(),\n",
    "        \"temp_mean\": temp.mean(), \"temp_std\": temp.std(),\n",
    "        \"n_windows\": len(hr_estimates)\n",
    "    }\n",
    "\n",
    "# S1 and S12 don't exist in WESAD (sensor malfunction during data collection)\n",
    "all_subjects = [f\"S{i}\" for i in range(2, 18) if i != 12]\n",
    "\n",
    "results = []\n",
    "for subj in all_subjects:\n",
    "    try:\n",
    "        results.append(extract_wesad_hr_temp(subj, wesad_data_folder))\n",
    "        print(f\"{subj}: done\")\n",
    "    except FileNotFoundError:\n",
    "        print(f\"{subj}: file not found, skipping\")\n",
    "\n",
    "wesad_all_subjects = pd.DataFrame(results)\n",
    "wesad_all_subjects"
   ]
