    "        ax.plot(mean_pred, frac_pos, color=color, ls=ls, marker=marker, ms=4, lw=1.2, mfc=\"white\",\n",
    "                label=f\"{label} (int. {inter}, slope {slope})\")\n",
    "    lim = min(1.0, top * 1.1)\n",
    "    ax.plot([0, lim], [0, lim], color=\"black\", lw=0.8, ls=(0, (1, 1)), label=\"Perfect calibration\")\n",
    "    ax.set_xlim(0, lim); ax.set_ylim(0, lim)\n",
    "    ax.set_xlabel(\"Mean predicted risk\"); ax.set_title(title, fontsize=9.5)\n",
