    "# ===== Interpretation: which features push risk up or down? (main logistic regression) =====\n",
    "# Odds ratio = exp(coefficient). Above 1 = higher risk, below 1 = lower risk.\n",
    "# Numeric features were standardized, so their odds ratio is \"per 1 standard deviation\".\n",
    "# Category odds ratios are relative to the model's average category, not to a fixed reference group.\n",
    "lr_classifier = logistic_model.named_steps[\"classifier\"]\n",
    "feature_names_lr = logistic_model.named_steps[\"preprocessor\"].get_feature_names_out()\n",
    "\n",
    "coef_df = pd.DataFrame({\"feature\": feature_names_lr, \"coefficient\": lr_classifier.coef_[0]})\n",
    "coef_df[\"odds_ratio\"] = np.exp(coef_df[\"coefficient\"])\n",
    "coef_df = coef_df.sort_values(\"odds_ratio\", ascending=False)\n",
    "\n",
    "print(\"Top 15 features increasing risk:\")\n",
    "print(coef_df.head(15).to_string(index=False))\n",
    "print()\n",
    "print(\"Top 15 features decreasing risk:\")\n",
    "print(coef_df.tail(15).to_string(index=False))\n",
    "\n",
    "# How many TRAINING surgeries sit behind the top procedure codes? (small groups = unstable odds ratios)\n",
    "train_df = X_train.assign(outcome=y_train.values)\n",
    "top_codes = [f for f in coef_df[\"feature\"] if f.startswith(\"cat__icd10_pcs_\") and \"infrequent\" not in f][:5]\n",
    "print(\"\\nTop procedure codes (training data):\")\n",
    "for code in top_codes:\n",
    "    raw_code = code.replace(\"cat__icd10_pcs_\", \"\")\n",
    "    grp = train_df[train_df[\"icd10_pcs\"].astype(str) == raw_code]\n",
    "    print(f\"  {raw_code}: {len(grp)} surgeries, {grp['outcome'].sum()} complications \"\n",
    "          f\"(rate {grp['outcome'].mean():.3f})\")"
   ]
  },
