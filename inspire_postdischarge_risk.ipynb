   "metadata": {},
   "outputs": [],
   "source": [
    "# Pull each patient's most recent blood-test results from BEFORE their surgery\n",
    "# only (never after - that would be an unfair sneak-preview for the model),\n",
    "# looking back at most 30 days, and add them to our feature table.\n",
    "important_labs = [\n",
    "    \"glucose\", \"creatinine\", \"hb\", \"hct\", \"wbc\",\n",
    "    \"platelet\", \"sodium\", \"potassium\", \"bun\", \"albumin\", \"crp\"\n",
    "]\n",
    "LOOKBACK_MINUTES = 30 * 24 * 60   # 30 days (INSPIRE times are in minutes)\n",
    "\n",
    "labs = datasets[\"labs\"]\n",
    "labs_filtered = labs[labs[\"item_name\"].isin(important_labs)]\n",
    "\n",
    "surgery_times = model_df[[\"subject_id\", \"op_id\", \"opstart_time\"]].dropna(subset=[\"opstart_time\"]).copy()\n",
    "surgery_times[\"opstart_time\"] = surgery_times[\"opstart_time\"].astype(\"int32\")\n",
    "\n",
    "preop_labs = labs_filtered.merge(surgery_times, on=\"subject_id\", how=\"inner\")\n",
    "preop_labs = preop_labs[\n",
    "    (preop_labs[\"chart_time\"] < preop_labs[\"opstart_time\"]) &\n",
    "    (preop_labs[\"chart_time\"] >= preop_labs[\"opstart_time\"] - LOOKBACK_MINUTES)\n",
    "]\n",
    "\n",
    "# Sort by time so \"last\" really means the most recent result before surgery\n",
    "preop_labs = preop_labs.sort_values(\"chart_time\")\n",
    "preop_labs_wide = (\n",
    "    preop_labs.groupby([\"subject_id\", \"op_id\", \"item_name\"], observed=True)[\"value\"]\n",
    "    .last()\n",
    "    .unstack(\"item_name\")\n",
    "    .reset_index()\n",
    ")\n",
    "preop_labs_wide.columns.name = None\n",
    "preop_labs_wide = preop_labs_wide.rename(columns={c: f\"preop_{c}\" for c in important_labs})\n",
    "\n",
    "del preop_labs\n",
    "gc.collect()\n",
    "\n",
    "model_df = model_df.merge(preop_labs_wide, on=[\"subject_id\", \"op_id\"], how=\"left\")\n",
    "\n",
    "# How many operations have each lab within 30 days before surgery\n",
    "print(model_df[[f\"preop_{c}\" for c in important_labs]].notna().mean().round(3).sort_values())\n",
    "model_df.shape"
   ]
  },
