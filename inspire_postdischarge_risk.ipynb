    "# Split into three separate groups BY PATIENT: one to teach the model,\n",
    "# one to check its progress / pick settings, and one to test it fairly at\n",
    "# the very end. All surgeries of the same patient go into the same group,\n",
    "# so the model is never tested on a patient it has already seen in training.\n",
    "from sklearn.model_selection import train_test_split, StratifiedGroupKFold\n",
    "\n",
    "feature_cols = [c for c in model_df.columns if c not in [\n",
    "    \"subject_id\", \"op_id\", \"opstart_time\", \"opend_time\", \"Post_discharge_complication\"\n",
    "]]\n",
    "\n",
    "X = model_df[feature_cols]\n",
    "y = model_df[\"Post_discharge_complication\"]\n",
    "groups = model_df[\"subject_id\"]\n",
    "\n",
    "def group_split(X, y, groups, n_splits, seed=42):\n",
    "    # One fold of a stratified, patient-grouped K-fold = a patient-level\n",
    "    # holdout of about 1/n_splits, with a similar complication rate in each part\n",
    "    sgkf = StratifiedGroupKFold(n_splits=n_splits, shuffle=True, random_state=seed)\n",
    "    return next(sgkf.split(X, y, groups))\n",
    "\n",
    "# ~15% test (1/7), then ~15% of the total as validation (1/6 of the rest)\n",
    "temp_idx, test_idx = group_split(X, y, groups, n_splits=7)\n",
    "X_temp, X_test = X.iloc[temp_idx], X.iloc[test_idx]\n",
    "y_temp, y_test = y.iloc[temp_idx], y.iloc[test_idx]\n",
    "\n",
    "train_idx, val_idx = group_split(X_temp, y_temp, groups.iloc[temp_idx], n_splits=6)\n",
    "X_train, X_val = X_temp.iloc[train_idx], X_temp.iloc[val_idx]\n",
    "y_train, y_val = y_temp.iloc[train_idx], y_temp.iloc[val_idx]\n",
    "\n",
    "# Patient IDs per group - used again later for group-aware cross-validation\n",
    "groups_train = model_df.loc[X_train.index, \"subject_id\"]\n",
    "\n",
    "# Check: no patient appears in more than one group\n",
    "ids = lambda d: set(model_df.loc[d.index, \"subject_id\"])\n",
    "assert not (ids(X_train) & ids(X_test)), \"patient overlap train/test\"\n",
    "assert not (ids(X_train) & ids(X_val)), \"patient overlap train/val\"\n",
    "assert not (ids(X_val) & ids(X_test)), \"patient overlap val/test\"\n",
    "print(\"No patient appears in more than one group.\\n\")\n",
    "\n",
    "for name, Xs, ys in [(\"Train\", X_train, y_train), (\"Val\", X_val, y_val), (\"Test\", X_test, y_test)]:\n",
    "    print(f\"{name:5}: {len(Xs):6,} operations | {len(ids(Xs)):6,} patients | complication rate {ys.mean():.4f}\")\n",
    "print(f\"\\nNumber of features: {len(feature_cols)}\")"
   ]
