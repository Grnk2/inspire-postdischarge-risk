from pathlib import Path
import matplotlib.pyplot as plt
from matplotlib.patches import FancyBboxPatch
plt.rcParams.update({"font.family": "serif"})
fig, ax = plt.subplots(figsize=(5.8, 9.6)); ax.set_xlim(0, 100); ax.set_ylim(15, 160); ax.axis("off")
def box(x, y, w, h, title, body, tfs=9.5, bfs=8.2):
    ax.add_patch(FancyBboxPatch((x - w/2, y - h/2), w, h, boxstyle="round,pad=0,rounding_size=1.2", fc="white", ec="black", lw=1.2))
    ax.text(x, y + h/2 - 2.2, title, ha="center", va="top", fontsize=tfs, fontweight="bold")
    ax.text(x, y + h/2 - 5.6, body, ha="center", va="top", fontsize=bfs, linespacing=1.15)
def arr(x, y1, y2):
    ax.annotate("", xy=(x, y2), xytext=(x, y1), arrowprops=dict(arrowstyle="-|>", color="black", lw=1.3, mutation_scale=10))
cols = [20, 50, 80]
box(50, 151, 90, 13, "INSPIRE perioperative database", "surgeries, pre-op labs, ward vitals, diagnoses\n130,960 surgeries · 99,886 patients")
arr(50, 144, 140)
box(50, 131.5, 90, 16.5, "Cohort and outcome labelling", "130,073 surgeries after exclusions\npositive = readmission, new complication code\nor death within 30 days of discharge (5.4%)")
for x in cols: arr(x, 123, 119)
for x, t, b in zip(cols, ["Tabular", "Sequence", "Text"],
                   ["41 features:\npatient, surgery,\n11 labs, 18 vital-\nsign features", "48 h × 4 vitals\n+ 4 'measured'\nflags", "24 features\nwritten as a\nnatural-language\ndescription"]):
    box(x, 109.5, 28.5, 19, t, b)
for x in cols: arr(x, 100, 96)
box(50, 91, 90, 10, "Patient-level split (StratifiedGroupKFold)", "train 92,863 · validation 18,489 · test 18,721 surgeries", tfs=9.2)
for x in cols: arr(x, 86, 82)
for x, t, b in zip(cols, ["Tabular", "Sequence", "LLM"],
                   ["logistic regression\nrandom forest\nXGBoost", "LSTM, compared\nwith vitals-only\nlogistic regression", "Llama 3.2 3B\nzero-shot,\nrun locally"]):
    box(x, 73.5, 28.5, 17, t, b)
for x in cols: arr(x, 65, 61)
box(50, 52, 90, 17, "Evaluation on the held-out test set", "ROC-AUC, PR-AUC, Brier score,\ncalibration slope and intercept; threshold chosen\non validation; 95% CIs resampling patients")
ax.plot([20, 80], [41.5, 41.5], color="black", lw=1.3); ax.plot([50, 50], [43.5, 41.5], color="black", lw=1.3)
for x in cols: arr(x, 41.5, 38)
for x, t, b in zip(cols, ["External", "Sensitivity", "Wearable"],
                   ["MIMIC-IV (USA)\n100,545\nadmissions", "strict outcome\n(emergency\nreadmission,\ncode or death)", "WESAD wrist\ndevice vs ward\nvital ranges"]):
    box(x, 28.5, 28.5, 19, t, b)
Path("figures_png").mkdir(exist_ok=True)
plt.savefig("figures_png/Fig1_system_pipeline.png", dpi=300, bbox_inches="tight")
plt.show()
print("Saved figures_png/Fig1_system_pipeline.png")

