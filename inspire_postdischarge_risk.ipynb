    "# - Categorical features with no MIMIC equivalent (ASA, department, anesthesia type, race)\n",
    "#   are set to \"Unknown\"; the encoder treats unseen values the same way for every patient.\n",
    "#   (MIMIC race categories don't match INSPIRE's, so race is not carried over.)\n",
    "# - Numeric features with no MIMIC equivalent (weight, height, surgery duration) are set to\n",
    "#   the INSPIRE training median, so they are constant and cannot drive predictions.\n",
    "# - Missing LAB values stay missing: the model's own imputer fills them exactly as it did\n",
    "#   for INSPIRE (training median + a \"was missing\" flag).\n",
    "for df in [mimic_full, mimic_well_covered]:\n",
    "    for col in [\"asa\", \"department\", \"antype\", \"race\"]:\n",
    "        df[col] = \"Unknown\"\n",
    "    for col in [\"weight\", \"height\", \"surgery_duration_hours\"]:\n",
    "        df[col] = X_train[col].median()\n",
