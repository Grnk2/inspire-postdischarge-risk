    "\n",
    "\n",
    "# ===== Review item 5: observability among surgeries still in hospital =====\n",
    "# Fig. 7a divides by ALL surgeries, so later hours look empty partly because many\n",
    "# patients have already gone home. Here the denominator at each hour is only the\n",
    "# surgeries whose observation window is still open at that hour: the patient has\n",
    "# not been discharged and has not gone back for a next surgery. This is the same\n",
    "# window the vital signs were collected in (cell \"For every surgery, work out its\n",
    "# own recovery time window\").\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "vital_cols = [\"hr\", \"spo2\", \"rr\", \"bt\"]\n",
    "vital_labels = [\"Heart rate\", \"SpO2\", \"Resp. rate\", \"Temperature\"]\n",
    "keys = [\"subject_id\", \"op_id\"]\n",
    "H = 48\n",
    "\n",
    "# ---- 1) Coverage per hour: all surgeries vs surgeries still in hospital ----\n",
    "win = model_df[keys].reset_index(drop=True).merge(\n",
    "    surgery_windows[keys + [\"opend_time\", \"window_end\"]], on=keys, how=\"left\")\n",
    "assert len(win) == len(X_seq), \"row order must match X_seq\"\n",
    "minutes_open = (win[\"window_end\"] - win[\"opend_time\"]).to_numpy()\n",
    "in_hosp = minutes_open[:, None] > 60 * np.arange(H)[None, :]          # (surgeries, 48)\n",
    "flags = X_seq[:, :, 4:8] > 0                                          # (surgeries, 48, 4)\n",
    "\n",
    "n_in_hosp = in_hosp.sum(axis=0)\n",
    "pct_in_hosp = 100 * in_hosp.mean(axis=0)\n",
    "cov_all = 100 * flags.mean(axis=0)                                    # (48, 4)\n",
    "cov_in = 100 * (flags & in_hosp[:, :, None]).sum(axis=0) / np.maximum(n_in_hosp, 1)[:, None]\n",
    "\n",
    "show = [0, 6, 12, 24, 47]\n",
    "cov_table = pd.DataFrame({\"% of surgeries still in hospital\": pct_in_hosp[show].round(1)},\n",
    "                         index=[f\"hour {h}\" for h in show])\n",
    "for j, lab in enumerate(vital_labels):\n",
    "    cov_table[f\"{lab}: all surgeries\"] = cov_all[show, j].round(1)\n",
    "    cov_table[f\"{lab}: still in hospital\"] = cov_in[show, j].round(1)\n",
    "print(\"Coverage (% of surgeries with at least one reading in that hour):\")\n",
    "print(cov_table.T.to_string())\n",
    "cov_table.T.to_csv(\"observability_coverage_in_hospital.csv\")\n",
    "\n",
    "print(f\"\\nCheck of the paper's '14-30% by hour 6' (hour 6 = 6 to 7 h after surgery):\")\n",
    "print(\"  all surgeries     :\", \", \".join(f\"{l} {cov_all[6, j]:.1f}%\" for j, l in enumerate(vital_labels)))\n",
    "print(\"  still in hospital :\", \", \".join(f\"{l} {cov_in[6, j]:.1f}%\" for j, l in enumerate(vital_labels)))\n",
    "\n",
    "# ---- 2) Typical time between readings (raw charting times, inside the same windows) ----\n",
    "def reading_gaps(vitals_df, windows_df, ops_keep, max_hours=48, batch_size=1000):\n",
    "    # Same matching as compute_postop_vital_sequences: each reading belongs to the most\n",
    "    # recent surgery before it, and only counts if it falls inside that surgery's window.\n",
    "    subjects = np.sort(vitals_df[\"subject_id\"].unique())\n",
    "    gap_parts, count_parts = [], []\n",
    "    for start in range(0, len(subjects), batch_size):\n",
    "        ids = subjects[start:start + batch_size]\n",
    "        vb = vitals_df[vitals_df[\"subject_id\"].isin(ids)].sort_values(\"chart_time\")\n",
    "        wb = windows_df[windows_df[\"subject_id\"].isin(ids)].sort_values(\"opend_time\")\n",
    "        if vb.empty or wb.empty:\n",
    "            continue\n",
    "        m = pd.merge_asof(vb, wb[[\"subject_id\", \"op_id\", \"opend_time\", \"window_end\"]],\n",
    "                          left_on=\"chart_time\", right_on=\"opend_time\", by=\"subject_id\", direction=\"backward\")\n",
    "        m = m[m[\"op_id\"].notna() & (m[\"chart_time\"] < m[\"window_end\"])\n",
    "              & (m[\"chart_time\"] - m[\"opend_time\"] < max_hours * 60)].copy()\n",
    "        m[\"op_id\"] = m[\"op_id\"].astype(\"int64\")\n",
    "        m = m[m[\"op_id\"].isin(ops_keep)]\n",
    "        m = (m.drop_duplicates([\"op_id\", \"item_name\", \"chart_time\"])\n",
    "              .sort_values([\"op_id\", \"item_name\", \"chart_time\"]))\n",
    "        m[\"gap_h\"] = m.groupby([\"op_id\", \"item_name\"], observed=True)[\"chart_time\"].diff() / 60\n",
    "        gap_parts.append(m.loc[m[\"gap_h\"].notna(), [\"item_name\", \"gap_h\"]].astype({\"item_name\": str}))\n",
    "        count_parts.append(m.groupby([\"op_id\", \"item_name\"], observed=True).size().rename(\"n\").reset_index()\n",
    "                            .astype({\"item_name\": str}))\n",
    "    return pd.concat(gap_parts, ignore_index=True), pd.concat(count_parts, ignore_index=True)\n",
