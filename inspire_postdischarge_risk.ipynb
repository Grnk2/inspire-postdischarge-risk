   "id": "0eb52fff",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the basic tools we need: pandas for tables, numpy for numbers,\n",
    "# matplotlib/seaborn for charts, gc for freeing up memory later.\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import gc\n",
    "np.random.seed(42)\n",
    "\n",
    "pd.set_option(\"display.max_columns\", 50)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ca46e030",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set the folder path where the INSPIRE data files live.\n",
    "data_folder = Path(\"inspire-a-publicly-available-research-dataset-for-perioperative-medicine-1.4.2\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "be889267",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sanity check BEFORE loading anything - catches a wrong path immediately\n",
    "# instead of silently proceeding with an empty `datasets` dict.\n",
    "print(\"data_folder:\", data_folder)\n",
    "print(\"Does it exist?:\", data_folder.exists())\n",
    "\n",
    "if data_folder.exists():\n",
    "    csv_files = list(data_folder.glob(\"*.csv\"))\n",
    "    print(\"CSV files found:\", len(csv_files))\n",
    "    if len(csv_files) == 0:\n",
    "        print(\"Folder exists but has no .csv files directly in it.\")\n",
    "        print(\"Everything in this folder:\", list(data_folder.iterdir()))\n",
    "        print(\"-> If you see a subfolder or a .zip here, that's the fix: point data_folder\")\n",
    "        print(\"   at the subfolder, or extract the zip first.\")\n",
    "else:\n",
    "    print(\"This path does not exist - fix `data_folder` above before continuing.\")\n",
    "    print(\"Parent folder contents:\", list(data_folder.parent.iterdir()) if data_folder.parent.exists() else \"parent doesn't exist either\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "08e29785",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the INSPIRE tables. Small tables load normally; the two huge ones\n",
    "# (ward_vitals ~45M rows, labs ~19M rows) are read in chunks and filtered\n",
    "# to only the items the model uses, with compact dtypes, to save memory.\n",
    "VITALS_KEEP = [\"hr\", \"spo2\", \"rr\", \"bt\"]\n",
    "LABS_KEEP = [\"glucose\", \"creatinine\", \"hb\", \"hct\", \"wbc\", \"platelet\",\n",
    "             \"sodium\", \"potassium\", \"bun\", \"albumin\", \"crp\"]\n",
    "BIG_TABLES = {\"ward_vitals\": VITALS_KEEP, \"labs\": LABS_KEEP}\n",
    "\n",
    "compact_dtypes = {\"subject_id\": \"int32\", \"chart_time\": \"int32\",\n",
    "                  \"item_name\": \"category\", \"value\": \"float32\"}\n",
    "\n",
    "def load_filtered(path, keep_items, chunksize=2_000_000):\n",
    "    # Read a big table piece by piece and keep only the rows we need\n",
    "    parts = []\n",
    "    for chunk in pd.read_csv(path, chunksize=chunksize,\n",
    "                             dtype={\"subject_id\": \"int32\", \"item_name\": \"string\"}):\n",
    "        chunk = chunk[chunk[\"item_name\"].isin(keep_items)]\n",
    "        chunk[\"value\"] = pd.to_numeric(chunk[\"value\"], errors=\"coerce\")\n",
    "        parts.append(chunk)\n",
    "    df = pd.concat(parts, ignore_index=True)\n",
    "    return df.astype({c: t for c, t in compact_dtypes.items() if c in df.columns})\n",
    "\n",
    "datasets = {}\n",
    "for file in sorted(data_folder.glob(\"*.csv\")):\n",
    "    if file.stem in BIG_TABLES:\n",
    "        datasets[file.stem] = load_filtered(file, BIG_TABLES[file.stem])\n",
    "    else:\n",
    "        datasets[file.stem] = pd.read_csv(file)\n",
    "    print(f\"{file.stem}: {datasets[file.stem].shape}\")\n",
    "\n",
    "if len(datasets) == 0:\n",
    "    raise FileNotFoundError(\n",
    "        f\"No CSVs loaded from {data_folder} - fix the path in the cell above and re-run \"\n",
    "        \"from there, not from this cell alone.\"\n",
    "    )\n",
    "\n",
    "total_mb = sum(df.memory_usage(deep=True).sum() for df in datasets.values()) / 1e6\n",
    "print(f\"Loaded tables: {list(datasets.keys())}  |  total memory: {total_mb:,.0f} MB\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "325deab0",
   "metadata": {},
   "source": [
    "### Data dictionary\n",
    "\n",
    "Documents every column across every table: dtype, missingness, cardinality.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "93f04970",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build a full inventory of every column in every table: what type of\n",
    "# data it holds, how much is missing, and how many unique values it has.\n",
    "# This is the 'data dictionary' - a map of what we're working with.\n",
    "data_dictionary_rows = []\n",
    "\n",
    "for name, df in datasets.items():\n",
    "    for col in df.columns:\n",
    "        data_dictionary_rows.append({\n",
    "            \"table\": name,\n",
    "            \"column\": col,\n",
    "            \"dtype\": str(df[col].dtype),\n",
    "            \"n_missing\": df[col].isna().sum(),\n",
    "            \"pct_missing\": round(df[col].isna().mean() * 100, 2),\n",
    "            \"n_unique\": df[col].nunique(),\n",
    "        })\n",
    "\n",
    "data_dictionary = pd.DataFrame(data_dictionary_rows)\n",
    "\n",
    "try:\n",
    "    data_dictionary.to_csv(\"data_dictionary.csv\", index=False)\n",
    "except OSError as e:\n",
    "    print(\"Skipping save - disk full, not blocking:\", e)\n",
    "\n",
    "data_dictionary\n"
   ]
  },
