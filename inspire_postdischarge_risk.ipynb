    "# Reshape the hour-by-hour vitals into a fixed 48-hour timeline for EVERY\n",
    "# surgery in model_df (same surgeries as the other models). Each hour has the\n",
    "# 4 vitals plus 4 yes/no \"was this vital actually measured this hour\" flags,\n",
    "# so the LSTM can tell real readings from filled-in gaps. Surgeries with no\n",
    "# ward vitals at all get an all-filled timeline with all flags = 0.\n",
    "vital_cols = [\"hr\", \"spo2\", \"rr\", \"bt\"]\n",
    "max_hours = 48\n",
    "keys = [\"subject_id\", \"op_id\"]\n",
    "\n",
    "op_order = model_df[keys].reset_index(drop=True)          # same row order as model_df\n",
    "full_grid = op_order.merge(pd.DataFrame({\"hour\": range(max_hours)}), how=\"cross\")\n",
    "hourly_full = full_grid.merge(hourly_vitals[keys + [\"hour\"] + vital_cols], on=keys + [\"hour\"], how=\"left\")\n",
    "hourly_full = hourly_full.sort_values(keys + [\"hour\"]).reset_index(drop=True)\n",
    "\n",
    "# \"Was measured\" flags BEFORE filling\n",
    "obs_cols = [f\"{c}_measured\" for c in vital_cols]\n",
    "hourly_full[obs_cols] = hourly_full[vital_cols].notna().astype(\"float32\").to_numpy()\n",
    "\n",
    "# Fill gaps: carry the last real reading forward within each surgery,\n",
    "# then use the TRAINING-set median for anything still missing\n",
    "train_ops = set(model_df.loc[X_train.index, \"op_id\"])\n",
    "hourly_full[vital_cols] = hourly_full.groupby(keys)[vital_cols].ffill()\n",
    "train_medians = hourly_vitals[hourly_vitals[\"op_id\"].isin(train_ops)][vital_cols].median()\n",
    "hourly_full[vital_cols] = hourly_full[vital_cols].fillna(train_medians)\n",
    "\n",
    "# Put rows back in model_df order (hours 0-47 within each surgery), then\n",
    "# reshape to (surgeries, 48 hours, 8 channels)\n",
    "hourly_full = op_order.merge(hourly_full, on=keys, how=\"left\", sort=False)\n",
    "n_ops = len(op_order)\n",
    "X_seq = hourly_full[vital_cols + obs_cols].to_numpy(\"float32\").reshape(n_ops, max_hours, 2 * len(vital_cols))\n",
    "y_seq = model_df[\"Post_discharge_complication\"].to_numpy().astype(int)\n",
    "del hourly_full, full_grid\n",
    "gc.collect()\n",
    "\n",
    "print(X_seq.shape, y_seq.shape, round(y_seq.mean(), 4))"
