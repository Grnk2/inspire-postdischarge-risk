    "# ===== Surgical cohort: admissions with an ICD-10-PCS \"Medical and Surgical\" procedure =====\n",
    "# INSPIRE uses ICD-10-PCS codes, so we keep MIMIC admissions coded in ICD-10 (version 10)\n",
    "# whose procedure is in the Medical and Surgical section (codes starting with \"0\").\n",
    "# This is closer to INSPIRE than \"any procedure at all\" (which includes things like\n",
    "# transfusions or imaging).\n",
    "procedures_icd = pd.read_csv(mimic_core_folder / \"hosp\" / \"procedures_icd.csv.gz\",\n",
    "                             parse_dates=[\"chartdate\"], dtype={\"icd_code\": str})\n",
    "\n",
    "surg_proc = procedures_icd[(procedures_icd[\"icd_version\"] == 10) &\n",
    "                           (procedures_icd[\"icd_code\"].str.startswith(\"0\"))]\n",
    "\n",
    "# One row per admission: the main surgical procedure (lowest seq_num) and its date\n",
    "surg_proc = (surg_proc.sort_values([\"hadm_id\", \"seq_num\"])\n",
    "                      .groupby(\"hadm_id\", as_index=False)\n",
    "                      .first()[[\"hadm_id\", \"icd_code\", \"chartdate\"]]\n",
    "                      .rename(columns={\"chartdate\": \"surgery_date\"}))\n",
    "\n",
    "# Shorten the MIMIC code to the same length INSPIRE uses (e.g. \"0SWC0\")\n",
    "inspire_code_len = int(X_train[\"icd10_pcs\"].dropna().astype(str).str.len().mode()[0])\n",
    "surg_proc[\"icd10_pcs\"] = surg_proc[\"icd_code\"].str[:inspire_code_len]\n",
    "print(\"INSPIRE icd10_pcs code length:\", inspire_code_len)\n",
    "\n",
    "mimic_cohort = all_adm.merge(surg_proc, on=\"hadm_id\", how=\"inner\")\n",
    "\n",
    "print(\"Surgical admissions:\", len(mimic_cohort))\n",
    "print(\"Unique patients:\", mimic_cohort[\"subject_id\"].nunique())\n",
    "print(\"30-day readmission rate:\", round(mimic_cohort[\"mimic_target\"].mean(), 4))"
