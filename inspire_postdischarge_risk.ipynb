   "source": [
    "# ===== Week 8b: small LLM (Ollama) - zero-shot risk scoring =====\n",
    "# The LLM runs LOCALLY on this laptop through Ollama, so no patient data leaves the computer.\n",
    "import json, re, time\n",
    "import ollama   # needs the Ollama app running in the background\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import roc_auc_score, average_precision_score\n",
    "\n",
    "LLM_MODEL = \"llama3.2:3b\"\n",
    "N_SAMPLE = 600   # a laptop takes ~1-3 s per patient, so we score a sample of the test set\n",
    "\n",
    "# Stratified sample from the TEST set (keeps the ~6% complication rate)\n",
    "_, X_llm, _, y_llm = train_test_split(X_test, y_test, test_size=N_SAMPLE, stratify=y_test, random_state=42)\n",
    "\n",
    "def fmt(value, digits=0, unit=\"\"):\n",
    "    # Missing values are written as \"not measured\" instead of \"nan\"\n",
    "    return \"not measured\" if pd.isna(value) else f\"{value:.{digits}f}{unit}\"\n",
    "\n",
    "def describe_patient(row):\n",
    "    # Turn one surgery into a short plain-English description (procedure codes left out)\n",
    "    labs = \", \".join(f\"{c.replace('preop_', '')} {fmt(row[c], 1)}\"\n",
    "                     for c in X_test.columns if c.startswith(\"preop_\"))\n",
    "    return (\n",
    "        f\"Age {fmt(row['age'])}, sex {row['sex']}, weight {fmt(row['weight'], 0, ' kg')}, \"\n",
    "        f\"height {fmt(row['height'], 0, ' cm')}. ASA class {row['asa']}. \"\n",
    "        f\"Emergency surgery: {'yes' if str(row['emop']) in ('1', '1.0') else 'no'}. \"\n",
    "        f\"Department {row['department']}, anesthesia {row['antype']}, \"\n",
    "        f\"surgery lasted {fmt(row['surgery_duration_hours'], 1, ' h')}. \"\n",
    "        f\"Pre-op labs: {labs}. \"\n",
    "        f\"Post-op ward vital signs (mean): HR {fmt(row['hr_rolling_mean'])}, SpO2 {fmt(row['spo2_rolling_mean'], 0, '%')}, \"\n",
    "        f\"RR {fmt(row['rr_rolling_mean'])}, temperature {fmt(row['bt_rolling_mean'], 1, ' C')}.\"\n",
    "    )\n",
    "\n",
    "SYSTEM = (\n",
    "    \"You are a perioperative risk assessment assistant. About 6% of surgical patients in this hospital have a \"\n",
    "    \"complication or are readmitted within 30 days of discharge. Given one patient, estimate their risk. \"\n",
    "    'Reply ONLY with JSON: {\"risk\": <integer 0-100>}'\n",
    ")\n",
    "\n",
    "def llm_risk(text):\n",
    "    resp = ollama.chat(\n",
    "        model=LLM_MODEL,\n",
    "        messages=[{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": text}],\n",
    "        format=\"json\", options={\"temperature\": 0},   # temperature 0 = same answer every run\n",
    "    )\n",
    "    content = resp[\"message\"][\"content\"]\n",
    "    try:\n",
    "        return float(json.loads(content)[\"risk\"]) / 100\n",
    "    except Exception:\n",
    "        m = re.search(r\"\\d+\", content)\n",
    "        return float(m.group()) / 100 if m else np.nan\n",
    "\n",
    "# Quick test on one patient before running all 600\n",
    "print(describe_patient(X_llm.iloc[0]))\n",
    "print(\"Test call ->\", llm_risk(describe_patient(X_llm.iloc[0])))"
   ]
  },
