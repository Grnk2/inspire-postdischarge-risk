   "source": [
    "# Exact Llama 3.2 3B zero-shot prompt for the report (Peter asked for this)\n",
    "example_text = describe_patient(X_llm.iloc[0])\n",
    "example_risk = llm_risk(example_text)\n",
    "prompt_report = (\n",
