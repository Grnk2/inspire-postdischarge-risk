   "source": [
    "# Train the LSTM on the SAME patients as LR/RF/XGBoost: train/val/test come\n",
    "# from the patient-level split in cell 38. Scaling uses training data only.\n",
    "# Unweighted, like the main LR and XGBoost models (keeps risks calibrated).\n",
    "# Early stopping watches VALIDATION PR-AUC.\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Input, LSTM, Dense, Dropout\n",
    "from tensorflow.keras.callbacks import EarlyStopping\n",
    "\n",
    "tf.keras.utils.set_random_seed(42)\n",
    "\n",
    "pos = {idx: i for i, idx in enumerate(model_df.index)}   # model_df row -> X_seq row\n",
    "tr = np.array([pos[i] for i in X_train.index])\n",
    "va = np.array([pos[i] for i in X_val.index])\n",
    "te = np.array([pos[i] for i in X_test.index])\n",
    "\n",
    "X_seq_train, y_seq_train = X_seq[tr], y_seq[tr]\n",
    "X_seq_val, y_seq_val = X_seq[va], y_seq[va]\n",
    "X_seq_test, y_seq_test = X_seq[te], y_seq[te]\n",
    "assert (y_seq_test == y_test.to_numpy()).all(), \"LSTM test set does not match the other models\"\n",
    "\n",
    "# Standardise the 4 vitals with TRAINING mean/std (flags stay 0/1)\n",
    "n_v = len(vital_cols)\n",
    "mu = X_seq_train[:, :, :n_v].reshape(-1, n_v).mean(axis=0)\n",
    "sd = X_seq_train[:, :, :n_v].reshape(-1, n_v).std(axis=0) + 1e-6\n",
    "def scale(a):\n",
    "    a = a.copy()\n",
    "    a[:, :, :n_v] = (a[:, :, :n_v] - mu) / sd\n",
    "    return a\n",
    "X_seq_train_scaled, X_seq_val_scaled, X_seq_test_scaled = map(scale, (X_seq_train, X_seq_val, X_seq_test))\n",
    "\n",
    "lstm_model = Sequential([\n",
    "    Input(shape=X_seq_train.shape[1:]),\n",
    "    LSTM(64),\n",
    "    Dropout(0.3),\n",
    "    Dense(32, activation=\"relu\"),\n",
    "    Dropout(0.2),\n",
    "    Dense(1, activation=\"sigmoid\"),\n",
    "])\n",
    "lstm_model.compile(optimizer=\"adam\", loss=\"binary_crossentropy\",\n",
    "                   metrics=[tf.keras.metrics.AUC(curve=\"PR\", name=\"pr_auc\")])\n",
    "\n",
    "early_stop = EarlyStopping(monitor=\"val_pr_auc\", mode=\"max\", patience=5, restore_best_weights=True)\n",
    "history = lstm_model.fit(\n",
    "    X_seq_train_scaled, y_seq_train,\n",
    "    validation_data=(X_seq_val_scaled, y_seq_val),\n",
    "    epochs=50, batch_size=256, callbacks=[early_stop], verbose=1,\n",
    ")\n",
    "lstm_model.save(\"lstm_model.keras\")\n",
    "print(\"Saved to lstm_model.keras\")"
   ]
