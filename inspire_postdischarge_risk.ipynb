   "source": [
    "## Week 3: Wearable Simulation & Initial Feature Engineering\n",
    "\n",
    "WESAD validation deferred until the dataset is available - everything else here doesn't need it.\n",
    "Uses `hr`, `spo2`, `rr`, `bt` from `ward_vitals` as the simulated wearable signal, since these are\n",
    "the modalities a wrist wearable would capture.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "76936014",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Start building our model's feature table: pick out the patient details\n",
    "# (age, sex, weight, height, health-risk score, surgery type, timing) we'll use.\n",
    "# Missing weight/height are NOT filled here - the model pipeline fills them\n",
    "# using training-set medians only, so test patients never influence training.\n",
    "model_df = operations[[\n",
    "    \"subject_id\", \"op_id\", \"age\", \"sex\", \"weight\", \"height\", \"race\",\n",
    "    \"asa\", \"emop\", \"department\", \"antype\", \"icd10_pcs\",\n",
    "    \"opstart_time\", \"opend_time\", \"surgery_duration_hours\"\n",
    "]].copy()\n",
    "\n",
    "# Exclude ASA 6 (brain-dead organ donors): no discharge, so no post-discharge outcome\n",
    "n_before = len(model_df)\n",
    "model_df = model_df[model_df[\"asa\"] != 6].copy()\n",
    "print(f\"Excluded {n_before - len(model_df)} ASA 6 operations\")\n",
    "\n",
    "# ASA is a category, so a missing value becomes its own \"Unknown\" group\n",
    "model_df[\"asa\"] = model_df[\"asa\"].fillna(\"Unknown\")\n",
    "\n",
    "print(\"Missing weight:\", model_df[\"weight\"].isna().sum(), \"| Missing height:\", model_df[\"height\"].isna().sum())\n",
    "model_df.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3f9e7465",
   "metadata": {},
   "source": [
    "### Free memory + extract the wearable-equivalent vitals\n",
    "\n",
    "**Important:** this cell deletes `vitals`, `medications`, `diagnosis`, and `ward_vitals` from\n",
    "`datasets` once their needed data has been pulled out. After this cell runs, those raw tables no\n",
    "longer exist in `datasets` for the rest of the session - this is why cells that reference them\n",
    "(like the Week 2 EDA cells above) must run _before_ this one, which they do here since this\n",
    "notebook is in the correct order. Don't jump back and re-run earlier cells individually after this\n",
    "one has run without restarting the kernel first.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e1789617",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Free up memory by removing tables we no longer need, then pull out just\n",
    "# the 4 vital signs a wearable device could actually measure\n",
    "# (heart rate, oxygen, breathing rate, temperature) as our 'simulated wearable signal'.\n",
    "# Safe to re-run: if ward_vitals was already converted and deleted, it reuses the result.\n",
    "important_vitals = [\"hr\", \"spo2\", \"rr\", \"bt\"]  # the 4 wearable-equivalent modalities\n",
    "\n",
    "for name in [\"vitals\", \"medications\"]:\n",
    "    datasets.pop(name, None)\n",
    "\n",
    "if \"ward_vitals\" in datasets:\n",
    "    hospital_vitals_wearable_sim = datasets[\"ward_vitals\"][[\"subject_id\", \"chart_time\", \"item_name\", \"value\"]]\n",
    "    hospital_vitals_wearable_sim = hospital_vitals_wearable_sim[\n",
    "        hospital_vitals_wearable_sim[\"item_name\"].isin(important_vitals)\n",
    "    ].astype({\"subject_id\": \"int32\", \"chart_time\": \"int32\", \"value\": \"float32\"})\n",
    "    hospital_vitals_wearable_sim[\"item_name\"] = (\n",
    "        hospital_vitals_wearable_sim[\"item_name\"].astype(str).astype(\"category\")\n",
    "    )\n",
    "    del datasets[\"ward_vitals\"]\n",
    "    gc.collect()\n",
    "elif \"hospital_vitals_wearable_sim\" not in globals():\n",
    "    raise RuntimeError(\"ward_vitals is gone and no converted copy exists - re-run cell 5 first.\")\n",
    "else:\n",
    "    print(\"ward_vitals already converted earlier - reusing hospital_vitals_wearable_sim\")\n",
    "\n",
    "hospital_vitals_wearable_sim.shape   # expected: (25502269, 4)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d3b64069",
   "metadata": {},
   "outputs": [],
   "source": [
    "# For every surgery, work out its own recovery time window - starting when\n",
    "# surgery ends, and stopping at whichever comes FIRST: the patient's discharge,\n",
    "# or that same patient's NEXT surgery. Capping at discharge stops vitals from a\n",
    "# later readmission (which is part of the outcome) leaking into the features.\n",
    "surgery_windows = operations[[\"subject_id\", \"op_id\", \"opstart_time\", \"opend_time\", \"discharge_time\"]].copy()\n",
    "surgery_windows = surgery_windows.dropna(subset=[\"opstart_time\", \"opend_time\"])\n",
    "surgery_windows[\"subject_id\"] = surgery_windows[\"subject_id\"].astype(\"int32\")\n",
    "surgery_windows[\"opstart_time\"] = surgery_windows[\"opstart_time\"].astype(\"int32\")\n",
    "surgery_windows[\"opend_time\"] = surgery_windows[\"opend_time\"].astype(\"int32\")\n",
    "\n",
    "surgery_windows = surgery_windows.sort_values([\"subject_id\", \"opstart_time\"]).reset_index(drop=True)\n",
    "surgery_windows[\"next_opstart\"] = surgery_windows.groupby(\"subject_id\")[\"opstart_time\"].shift(-1)\n",
    "\n",
    "# Window ends at the earlier of discharge and next surgery (missing values = no limit from that side)\n",
    "surgery_windows[\"window_end\"] = np.fmin(\n",
    "    surgery_windows[\"next_opstart\"].fillna(np.inf),\n",
    "    surgery_windows[\"discharge_time\"].fillna(np.inf),\n",
    ")\n",
    "\n",
    "# Sanity checks\n",
    "capped_by_discharge = (surgery_windows[\"discharge_time\"] < surgery_windows[\"next_opstart\"].fillna(np.inf)).sum()\n",
    "bad_discharge = (surgery_windows[\"discharge_time\"] < surgery_windows[\"opend_time\"]).sum()\n",
    "print(f\"Windows now ending at discharge instead of next surgery/never: {capped_by_discharge:,}\")\n",
    "print(f\"Operations with discharge recorded before surgery end (data errors, window will be empty): {bad_discharge:,}\")\n",
    "print(f\"Operations with no discharge time (window ends at next surgery or after 48h): {surgery_windows['discharge_time'].isna().sum():,}\")\n",
    "\n",
    "surgery_windows.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0f2ef455",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Go through the vitals data in patient-sized batches (to avoid running out of\n",
    "# memory) and, for every surgery, pull out its hour-by-hour vital signs\n",
    "# during its own recovery window.\n",
    "def compute_postop_vital_sequences(vitals_df, windows_df, max_hours=48, batch_size=1000):\n",
    "    \"\"\"\n",
    "    One row per (operation, hour-since-opend_time), capped at max_hours.\n",
    "    Batched by patient to keep peak memory bounded regardless of dataset size.\n",
    "    \"\"\"\n",
    "    all_subjects = np.sort(vitals_df[\"subject_id\"].unique())\n",
    "    results = []\n",
    "    n_batches = (len(all_subjects) // batch_size) + 1\n",
    "\n",
    "    for i, start in enumerate(range(0, len(all_subjects), batch_size)):\n",
    "        batch_ids = all_subjects[start:start + batch_size]\n",
    "        vitals_batch = vitals_df[vitals_df[\"subject_id\"].isin(batch_ids)]\n",
    "        windows_batch = windows_df[windows_df[\"subject_id\"].isin(batch_ids)]\n",
    "\n",
    "        if vitals_batch.empty or windows_batch.empty:\n",
    "            continue\n",
    "\n",
    "        vitals_sorted = vitals_batch.sort_values(\"chart_time\")\n",
    "        windows_sorted = windows_batch.sort_values(\"opend_time\")\n",
    "\n",
    "        merged = pd.merge_asof(\n",
    "            vitals_sorted,\n",
    "            windows_sorted[[\"subject_id\", \"op_id\", \"opend_time\", \"window_end\"]],\n",
    "            left_on=\"chart_time\", right_on=\"opend_time\", by=\"subject_id\", direction=\"backward\"\n",
    "        )\n",
    "\n",
    "        in_window = merged[merged[\"op_id\"].notna() & (merged[\"chart_time\"] < merged[\"window_end\"])].copy()\n",
    "\n",
    "        if not in_window.empty:\n",
    "            in_window[\"hour\"] = ((in_window[\"chart_time\"] - in_window[\"opend_time\"]) // 60).astype(int)\n",
    "            in_window = in_window[in_window[\"hour\"] < max_hours]\n",
    "\n",
    "            if not in_window.empty:\n",
    "                batch_hourly = (\n",
    "                    in_window\n",
    "                    .pivot_table(index=[\"subject_id\", \"op_id\", \"hour\"], columns=\"item_name\",\n",
    "                                 values=\"value\", aggfunc=\"mean\", observed=True)\n",
    "                    .reset_index()\n",
    "                )\n",
    "                results.append(batch_hourly)\n",
    "\n",
    "        del vitals_batch, windows_batch, vitals_sorted, windows_sorted, merged, in_window\n",
    "        if i % 10 == 0:\n",
    "            print(f\"batch {i}/{n_batches} done\")\n",
    "            gc.collect()\n",
    "\n",
    "    return pd.concat(results, ignore_index=True)\n",
    "\n",
    "\n",
    "hourly_vitals = compute_postop_vital_sequences(hospital_vitals_wearable_sim, surgery_windows, max_hours=48, batch_size=1000)\n",
    "hourly_vitals.shape\n",
    "\n",
    "      \n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6bd49666",
   "metadata": {},
   "source": [
    "### Rolling physiological features\n",
    "\n",
    "**Caveat for the write-up:** `hr_variability_proxy` (and `rr_variability_proxy`) are NOT true HRV.\n",
    "Real HRV (SDNN, RMSSD) requires beat-to-beat R-R intervals from continuous ECG/PPG. This is\n",
    "hourly-averaged spot-check heart rate, so it's a coarse variability-over-time feature only - name\n",
    "it accordingly.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "44b6c8cd",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Turn each surgery's hour-by-hour vitals into summary numbers per vital sign:\n",
    "# recent level (last 6 h), spread and trend over the whole post-op window,\n",
    "# and hour-to-hour variability. Uses only hours that were actually measured\n",
    "# (no back-filling), uses the real hour number for trends (so gaps in\n",
    "# monitoring are handled correctly), and leaves a feature missing (NaN) when\n",
    "# there isn't enough data - the model pipeline fills those later from\n",
    "# training data only.\n",
    "vital_cols = [\"hr\", \"spo2\", \"rr\", \"bt\"]\n",
    "recent_hours = 6   # \"rolling\" mean = average over the last 6 hours of monitoring\n",
    "keys = [\"subject_id\", \"op_id\"]\n",
    "\n",
    "hourly_vitals = hourly_vitals.sort_values(keys + [\"hour\"]).reset_index(drop=True)\n",
    "\n",
    "# How long each surgery was monitored, and for how many hours there was any reading\n",
    "rolling_features = (\n",
    "    hourly_vitals.groupby(keys)[\"hour\"]\n",
    "    .agg(vitals_rolling_hours_observed=\"size\", vitals_rolling_last_hour=\"max\")\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "for col in vital_cols:\n",
    "    obs = hourly_vitals.loc[hourly_vitals[col].notna(), keys + [\"hour\", col]].copy()\n",
    "    grp = obs.groupby(keys)\n",
    "\n",
    "    # Recent level (last 6 hours this vital was measured) and spread (whole window)\n",
    "    last_hour = grp[\"hour\"].transform(\"max\")\n",
    "    recent = obs[obs[\"hour\"] > last_hour - recent_hours]\n",
    "    level_spread = pd.concat([\n",
    "        recent.groupby(keys)[col].mean().rename(f\"{col}_rolling_mean\"),\n",
    "        grp[col].std().rename(f\"{col}_rolling_std\"),\n",
    "    ], axis=1)\n",
    "\n",
    "    # Trend: least-squares slope of value vs actual hour (units per hour)\n",
    "    obs[\"h_dev\"] = obs[\"hour\"] - grp[\"hour\"].transform(\"mean\")\n",
    "    obs[\"v_dev\"] = obs[col] - grp[col].transform(\"mean\")\n",
    "    obs[\"hv\"] = obs[\"h_dev\"] * obs[\"v_dev\"]\n",
    "    obs[\"hh\"] = obs[\"h_dev\"] ** 2\n",
    "    sums = obs.groupby(keys)[[\"hv\", \"hh\"]].sum()\n",
    "    trend = (sums[\"hv\"] / sums[\"hh\"].where(sums[\"hh\"] > 0)).rename(f\"{col}_trend\")\n",
    "\n",
    "    # Variability proxy: spread of the change between consecutive readings\n",
    "    # (NOT true HRV - see the markdown note above)\n",
    "    obs[\"step\"] = grp[col].diff()\n",
    "    variability = obs.groupby(keys)[\"step\"].std().rename(f\"{col}_variability_proxy\")\n",
    "\n",
    "    rolling_features = (\n",
    "        rolling_features\n",
    "        .merge(level_spread.reset_index(), on=keys, how=\"left\")\n",
    "        .merge(trend.reset_index(), on=keys, how=\"left\")\n",
    "        .merge(variability.reset_index(), on=keys, how=\"left\")\n",
    "    )\n",
    "\n",
    "# SpO2 variability needs 3+ SpO2 readings and is ~66% missing, so it is dropped\n",
    "rolling_features = rolling_features.drop(columns=[\"spo2_variability_proxy\"])\n",
    "\n",
    "print(rolling_features.shape)   # expected: (127550, 19)\n",
    "rolling_features.isna().mean().round(3).sort_values(ascending=False).head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3d3012b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add these new summary numbers onto our main feature table.\n",
    "model_df = model_df.merge(rolling_features, on=[\"subject_id\", \"op_id\"], how=\"left\")\n",
    "model_df.shape\n"
   ]
  },
